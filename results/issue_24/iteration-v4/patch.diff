+    index = _build([_row("BEISPIELMARKT", LEBENSMITTEL)])
+    # Compares equal to the index's version, but is not it.
+    with pytest.raises(classifier.KnnError):
+        _query(index, "BEISPIELMARKT", normaliser_version=_Chameleon("other"))
