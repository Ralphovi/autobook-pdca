+# --- (h): recency ------------------------------------------------------------------
+
+
+def test_recent_habit_outvotes_an_older_majority() -> None:
+    rows = [_row("MUSTER VERMIETER", LEBENSMITTEL, days_before=1500) for _ in range(3)]
+    rows += [_row("MUSTER VERMIETER", MIETE, days_before=10) for _ in range(2)]
