+
+def _resolve(profiles: Mapping[str, _Profile]) -> dict[str, _Rules]:
+    """Each profile's effective rules: its own, then those of the profile it extends."""
+    effective: dict[str, _Rules] = {}
+    for name in sorted(profiles):
