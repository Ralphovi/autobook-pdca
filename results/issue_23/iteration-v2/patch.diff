index 0000000..1c88514
--- /dev/null
+++ b/src/autobook/pipeline/profiles/default.toml
@@ -0,0 +1,26 @@
+# Package profile `default`: strips the noise around a merchant name, in general form.
+# Patterns are Python `re` syntax and run, in order, on the upper-cased memo; every
+# match is replaced by a space. Multi-word merchant names are left alone.
+
+# Boilerplate.
+[[rules]]
+pattern = '\bSAGT DANKE\b'
+
+# Card fragments: KARTE <digits>.
+[[rules]]
+pattern = '\bKARTE \d+'
+
+# Reference fragments: REF <digits>, NR. <digits>.
+[[rules]]
+pattern = '\bREF \d+'
+
+[[rules]]
+pattern = '\bNR\. *\d+'
+
+# Embedded dates: DD.MM. and DD.MM.YYYY.
+[[rules]]
+pattern = '\b\d{1,2}\.\d{1,2}\.(?:\d{4})?'
+
+# Standalone digit runs.
+[[rules]]
+pattern = '\b\d+\b'
