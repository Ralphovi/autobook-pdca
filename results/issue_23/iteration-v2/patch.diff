+__all__ = [
+    "NORMALISER_VERSION",
+    "NormalisedMemo",
+    "Normaliser",
+    "NormaliserError",
+    "load",
+]
+
+# Bump when the code (not a profile) changes what a token looks like. It is one input
+# of `Normaliser.version` and is never recorded on its own: a profile edit would not
+# move it.
+NORMALISER_VERSION: Final[int] = 1
+
+_ACCOUNTS_FILE: Final = "accounts"  # accounts.toml is the mapping, never a profile
+_DEFAULT_PROFILE: Final = "default"
+_DIGEST_HEX_DIGITS: Final = 12
+
+
+class NormaliserError(ValueError):
+    """A profile, the account mapping or an account path was not accepted."""
+
+
+@dataclasses.dataclass(frozen=True)
+class NormalisedMemo:
+    """One normalised memo; ``raw_memo`` is the input, unchanged."""
+
+    raw_memo: str
+    token: str
+    profile: str
+    version: str
+
+
+@dataclasses.dataclass(frozen=True)
+class _Profile:
+    name: str
+    patterns: tuple[str, ...]
+    rules: tuple[re.Pattern[str], ...]
+
+
+class Normaliser:
+    """Normalises memos with the profiles in effect. Build one with `load`."""
+
+    def __init__(
+        self,
+        *,
+        profiles: dict[str, _Profile],
+        accounts: dict[tuple[str, ...], str],
+        version: str,
+    ) -> None:
+        self._profiles = profiles
+        self._accounts = accounts
+        self.version = version
+
+    def normalise(self, raw_memo: str, source_account: tuple[str, ...]) -> NormalisedMemo:
+        """Return the token for ``raw_memo``, using the profile mapped to the account."""
+        path = _account_path(source_account, "source account")
+        name = self._accounts.get(path, _DEFAULT_PROFILE)
+        text = raw_memo.upper()
+        for rule in self._profiles[name].rules:
+            text = rule.sub(" ", text)
+        token = " ".join(text.split())
+        return NormalisedMemo(
+            raw_memo=raw_memo, token=token, profile=name, version=self.version
+        )
+
+
+def load(user_dir: pathlib.Path | None = None) -> Normaliser:
+    """Load the package profiles, then the user directory's, and build a `Normaliser`.
+
+    ``None`` means ``$XDG_CONFIG_HOME/autobook/normaliser/`` (``~/.config`` when the
+    variable is unset or empty). A missing directory means package profiles only.
+    """
+    directory = _default_user_dir() if user_dir is None else user_dir
+    profiles = _load_package_profiles()
+    accounts: dict[tuple[str, ...], str] = {}
+    for file in _user_files(directory):
+        name = file.name.removesuffix(".toml")
+        if name == _ACCOUNTS_FILE:
+            accounts = _parse_accounts(_read_toml(file.read_bytes, str(file)), str(file))
+        else:
+            profiles[name] = _parse_profile(
+                name, _read_toml(file.read_bytes, str(file)), str(file)
+            )
+    if _DEFAULT_PROFILE not in profiles:
+        raise NormaliserError(f"no profile named {_DEFAULT_PROFILE!r} is available")
+    for path, name in accounts.items():
+        if name not in profiles:
+            raise NormaliserError(
+                f"accounts.toml: account {list(path)} names the unknown profile {name!r}"
+            )
+    return Normaliser(
+        profiles=profiles, accounts=accounts, version=_version(profiles, accounts)
+    )
+
+
+def _default_user_dir() -> pathlib.Path:
+    config_home = os.environ.get("XDG_CONFIG_HOME")
+    base = pathlib.Path(config_home) if config_home else pathlib.Path.home() / ".config"
+    return base / "autobook" / "normaliser"
+
+
+def _user_files(directory: pathlib.Path) -> list[pathlib.Path]:
+    """The ``*.toml`` files in the user directory; none when the directory is missing.
+
+    Only a missing directory means "no user files". One that exists but cannot be
+    listed raises, so a user's profiles and mapping are never dropped without a word
+    (``Path.exists`` and ``Path.glob`` swallow ``PermissionError``, so neither is used).
+    Hidden names (an editor's lock or backup file) are not profiles.
+    """
+    try:
+        with os.scandir(directory) as entries:
+            return sorted(
+                pathlib.Path(entry.path)
+                for entry in entries
+                if entry.name.endswith(".toml")
+                and not entry.name.startswith(".")
+                and not entry.is_dir()
+            )
+    except FileNotFoundError:
+        return []
+    except OSError as error:  # PermissionError, NotADirectoryError, …
+        raise NormaliserError(
+            f"{directory}: cannot read the user directory: {error}"
+        ) from error
+
+
+def _load_package_profiles() -> dict[str, _Profile]:
+    root: Traversable = importlib.resources.files("autobook.pipeline") / "profiles"
+    profiles: dict[str, _Profile] = {}
+    for entry in sorted(root.iterdir(), key=lambda item: item.name):
+        if not entry.is_file() or not entry.name.endswith(".toml"):
+            continue
+        name = entry.name.removesuffix(".toml")
+        if name == _ACCOUNTS_FILE:
+            continue
+        where = f"package profile {entry.name}"
+        profiles[name] = _parse_profile(name, _read_toml(entry.read_bytes, where), where)
+    return profiles
+
+
+def _read_toml(read: Callable[[], bytes], where: str) -> dict[str, Any]:
+    try:
+        return tomllib.loads(read().decode("utf-8"))
+    except (OSError, ValueError) as error:  # TOMLDecodeError and UnicodeDecodeError
+        raise NormaliserError(f"{where}: cannot read as TOML: {error}") from error
+
+
+def _parse_profile(name: str, document: dict[str, Any], where: str) -> _Profile:
+    extra = sorted(set(document) - {"rules"})
+    if extra:
+        raise NormaliserError(
+            f"{where}: unknown top-level key(s) {extra}; only 'rules' is allowed"
+        )
+    rules = document.get("rules", [])
+    if not isinstance(rules, list):
+        raise NormaliserError(f"{where}: 'rules' must be an array of tables ([[rules]])")
+    patterns: list[str] = []
+    compiled: list[re.Pattern[str]] = []
+    for index, rule in enumerate(rules, start=1):
+        label = f"{where}: rule {index}"
+        if not isinstance(rule, dict) or set(rule) != {"pattern"}:
+            raise NormaliserError(f"{label}: a rule has exactly one key, 'pattern'")
+        pattern = rule["pattern"]
+        if not isinstance(pattern, str):
+            raise NormaliserError(f"{label}: 'pattern' must be a string")
+        try:
+            compiled.append(re.compile(pattern))
+        except re.error as error:
+            raise NormaliserError(f"{label}: invalid regular expression: {error}") from error
+        patterns.append(pattern)
+    return _Profile(name=name, patterns=tuple(patterns), rules=tuple(compiled))
+
+
+def _parse_accounts(document: dict[str, Any], where: str) -> dict[tuple[str, ...], str]:
+    extra = sorted(set(document) - {"accounts"})
+    if extra:
+        raise NormaliserError(
+            f"{where}: unknown top-level key(s) {extra}; only 'accounts' is allowed"
+        )
+    entries = document.get("accounts", [])
+    if not isinstance(entries, list):
+        raise NormaliserError(f"{where}: 'accounts' must be an array of tables ([[accounts]])")
+    mapping: dict[tuple[str, ...], str] = {}
+    for index, entry in enumerate(entries, start=1):
+        label = f"{where}: account {index}"
+        if not isinstance(entry, dict) or set(entry) != {"path", "profile"}:
+            raise NormaliserError(
+                f"{label}: an entry has exactly the keys 'path' and 'profile'"
+            )
+        path = _account_path(entry["path"], label)
+        profile = entry["profile"]
+        if not isinstance(profile, str):
+            raise NormaliserError(f"{label}: 'profile' must be a string")
+        if path in mapping:
+            raise NormaliserError(f"{label}: account {list(path)} is mapped twice")
+        mapping[path] = profile
+    return mapping
+
+
+def _account_path(value: object, where: str) -> tuple[str, ...]:
+    """An account path is a non-empty list of non-empty strings, never a joined string."""
+    if (
+        not isinstance(value, (list, tuple))
+        or not value
+        or not all(isinstance(part, str) and part for part in value)
+    ):
+        raise NormaliserError(
+            f"{where}: an account path is a non-empty list of non-empty strings, got {value!r}"
+        )
+    return tuple(value)
+
+
+def _version(profiles: dict[str, _Profile], accounts: dict[tuple[str, ...], str]) -> str:
+    # Canonical: sorted by profile name and by account path. No file path, file name
+    # (other than the profile name), or timestamp enters the digest.
+    canonical = {
+        "profiles": [[name, list(profiles[name].patterns)] for name in sorted(profiles)],
+        "accounts": [[list(path), accounts[path]] for path in sorted(accounts)],
+    }
+    payload = json.dumps(canonical, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+    digest = hashlib.sha256(payload.encode("ascii")).hexdigest()
+    return f"{NORMALISER_VERSION}-{digest[:_DIGEST_HEX_DIGITS]}"
