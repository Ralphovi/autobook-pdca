@@ -0,0 +1,341 @@
+"""The normaliser: profiles, user-directory overrides, account mapping and version.
+
+Every name the normaliser adds is reached through the module object inside the test
+body, so a tree without them fails the test instead of failing to collect it.
+"""
+
+from __future__ import annotations
+
+import importlib.resources
+import os
+import re
+import tomllib
+from typing import TYPE_CHECKING
+
+import pytest
+
+from autobook.pipeline import normaliser
+from tests.fixtures.synthetic import corpus_builder
+
+if TYPE_CHECKING:
+    import pathlib
+
+GIROKONTO = corpus_builder.GIROKONTO
+SEPA_TAGS = ("EREF+", "MREF+", "CRED+", "SVWZ+", "ABWA+")
+
+SEPA_MAPPING = """\
+[[accounts]]
+path = ["Aktiva", "Girokonto"]
+profile = "sepa"
+"""
+
+
+def _write(directory: pathlib.Path, name: str, text: str) -> pathlib.Path:
+    directory.mkdir(parents=True, exist_ok=True)
+    (directory / name).write_text(text, encoding="utf-8")
+    return directory
+
+
+def _text(result: normaliser.NormalisedMemo) -> str:
+    return result.token
+
+
+def _expected_token(raw_memo: str) -> str:
+    for merchant in corpus_builder.MERCHANTS:
+        if raw_memo.startswith(merchant.token):
+            return merchant.token
+    assert raw_memo.startswith(corpus_builder.NOVEL_MERCHANT), raw_memo
+    return corpus_builder.NOVEL_MERCHANT
+
+
+# --- (a) the corpus --------------------------------------------------------------
+
+
+@pytest.mark.parametrize("seed", [0, 1, 2])
+def test_every_corpus_row_normalises_to_its_merchant(seed: int, tmp_path: pathlib.Path) -> None:
+    loaded = normaliser.load(tmp_path)
+    rows = corpus_builder.build_corpus(seed).rows
+    assert rows
+    for row in rows:
+        result = loaded.normalise(row.raw_memo, row.source_account)
+        assert result.token == _expected_token(row.raw_memo), row.raw_memo
+        assert result.profile == "default"
+
+
+# --- (b) SEPA --------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("memo", "token"),
+    [
+        (
+            "EREF+NOTPROVIDED MREF+M0001 CRED+DE98ZZZ09999999999 "
+            "SVWZ+BEISPIELMARKT KARTE 4711 05.03. ABWA+ERFUNDEN PERSON",
+            "BEISPIELMARKT",
+        ),
+        (
+            "BEISPIELMARKT EREF+R20250305 MREF+M0002 CRED+DE98ZZZ09999999999 "
+            "SVWZ+SAGT DANKE 99",
+            "BEISPIELMARKT",
+        ),
+        (
+            "SVWZ+Muster Hausverwaltung REF 8812 05.03.2025 EREF+X9 MREF+Y9",
+            "MUSTER HAUSVERWALTUNG",
+        ),
+        ("SVWZ+neuheim kiosk NR. 55", "NEUHEIM KIOSK"),
+        # Fields joined with no space between a value and the next tag.
+        ("EREF+NOTPROVIDEDSVWZ+BEISPIELMARKT", "BEISPIELMARKT"),
+        ("EREF+123 MREF+456SVWZ+BEISPIELMARKT", "BEISPIELMARKT"),
+        ("SVWZ+BEISPIELMARKTEREF+ABC", "BEISPIELMARKT"),
+        ("BEISPIELMARKTCRED+DE98ZZZ09999999999MREF+M7SVWZ+KARTE 4711", "BEISPIELMARKT"),
+    ],
+)
+def test_sepa_profile_strips_sepa_fields(memo: str, token: str, tmp_path: pathlib.Path) -> None:
+    _write(tmp_path, "accounts.toml", SEPA_MAPPING)
+    result = normaliser.load(tmp_path).normalise(memo, GIROKONTO)
+    assert result.profile == "sepa"
+    assert result.token == token
+    for tag in SEPA_TAGS:
+        assert tag not in result.token
+
+
+def test_sepa_profile_ends_with_exactly_the_default_rules() -> None:
+    # A profile file has no include, so `sepa` repeats `default`'s rules; this keeps the
+    # copy from drifting when only one file is edited.
+    profiles = importlib.resources.files("autobook.pipeline") / "profiles"
+    default = tomllib.loads((profiles / "default.toml").read_text(encoding="utf-8"))
+    sepa = tomllib.loads((profiles / "sepa.toml").read_text(encoding="utf-8"))
+    assert default["rules"]
+    assert len(sepa["rules"]) > len(default["rules"])
+    assert sepa["rules"][-len(default["rules"]) :] == default["rules"]
+
+
+def test_sepa_profile_applies_only_to_the_mapped_account(tmp_path: pathlib.Path) -> None:
+    _write(tmp_path, "accounts.toml", SEPA_MAPPING)
+    loaded = normaliser.load(tmp_path)
+    memo = "EREF+ABC SVWZ+BEISPIELMARKT"
+    assert _text(loaded.normalise(memo, GIROKONTO)) == "BEISPIELMARKT"
+    unmapped = loaded.normalise(memo, corpus_builder.REVOLUT)
+    assert unmapped.profile == "default"
+    assert "EREF+" in unmapped.token
+
+
+# --- (c) override ----------------------------------------------------------------
+
+
+def test_user_profile_replaces_the_package_profile_of_the_same_name(
+    tmp_path: pathlib.Path,
+) -> None:
+    memo = "EREF+ABC SVWZ+BEISPIELMARKT KARTE 77"
+    mapped = _write(tmp_path / "mapped", "accounts.toml", SEPA_MAPPING)
+    package = normaliser.load(mapped).normalise(memo, GIROKONTO)
+    assert _text(package) == "BEISPIELMARKT"
+
+    user = _write(tmp_path / "user", "accounts.toml", SEPA_MAPPING)
+    # The user file strips the SVWZ tag only: whole-file replacement, no merge.
+    _write(user, "sepa.toml", "[[rules]]\npattern = '\\bSVWZ\\+'\n")
+    replaced = normaliser.load(user).normalise(memo, GIROKONTO)
+    assert _text(replaced) == "EREF+ABC BEISPIELMARKT KARTE 77"
+    assert replaced.token != package.token
+
+    # With the user file gone, the package profile applies again.
+    (user / "sepa.toml").unlink()
+    assert _text(normaliser.load(user).normalise(memo, GIROKONTO)) == "BEISPIELMARKT"
+
+
+def test_user_file_with_a_new_name_adds_a_profile(tmp_path: pathlib.Path) -> None:
+    _write(tmp_path, "shop.toml", "[[rules]]\npattern = '\\bFILIALE\\b'\n")
+    _write(
+        tmp_path,
+        "accounts.toml",
+        '[[accounts]]\npath = ["Aktiva", "Revolut"]\nprofile = "shop"\n',
+    )
+    result = normaliser.load(tmp_path).normalise(
+        "Beispielmarkt Filiale 12", corpus_builder.REVOLUT
+    )
+    assert result.profile == "shop"
+    assert _text(result) == "BEISPIELMARKT 12"
+
+
+# --- (d) version -----------------------------------------------------------------
+
+PROFILE = "[[rules]]\npattern = '\\bKARTE \\d+'\n\n[[rules]]\npattern = '\\bREF \\d+'\n"
+
+
+def _user_dir(
+    directory: pathlib.Path, profile: str = PROFILE, mapping: str = ""
+) -> pathlib.Path:
+    _write(directory, "shop.toml", profile)
+    _write(directory, "accounts.toml", mapping or SEPA_MAPPING)
+    return directory
+
+
+def test_version_has_the_documented_shape(tmp_path: pathlib.Path) -> None:
+    version = normaliser.load(tmp_path).version
+    assert re.fullmatch(rf"{normaliser.NORMALISER_VERSION}-[0-9a-f]{{12}}", version)
+
+
+def test_same_files_give_the_same_version_from_different_directories(
+    tmp_path: pathlib.Path,
+) -> None:
+    first = _user_dir(tmp_path / "first")
+    second = _user_dir(tmp_path / "second")
+    assert normaliser.load(first).version == normaliser.load(first).version
+    assert normaliser.load(first).version == normaliser.load(second).version
+
+
+def test_a_changed_rule_or_mapping_line_changes_the_version(tmp_path: pathlib.Path) -> None:
+    base = normaliser.load(_user_dir(tmp_path / "base")).version
+    rule = normaliser.load(
+        _user_dir(tmp_path / "rule", profile=PROFILE.replace("KARTE", "CARD"))
+    ).version
+    mapping = normaliser.load(
+        _user_dir(tmp_path / "mapping", mapping=SEPA_MAPPING.replace("sepa", "default"))
+    ).version
+    empty = normaliser.load(tmp_path / "absent").version
+    assert len({base, rule, mapping, empty}) == 4
+
+
+def test_rule_order_is_part_of_the_version(tmp_path: pathlib.Path) -> None:
+    swapped = "[[rules]]\npattern = '\\bREF \\d+'\n\n[[rules]]\npattern = '\\bKARTE \\d+'\n"
+    first = normaliser.load(_user_dir(tmp_path / "a")).version
+    second = normaliser.load(_user_dir(tmp_path / "b", profile=swapped)).version
+    assert first != second
+
+
+def test_every_result_carries_the_version_and_the_unchanged_raw_memo(
+    tmp_path: pathlib.Path,
+) -> None:
+    loaded = normaliser.load(_user_dir(tmp_path))
+    for memo in ("  Beispielmarkt   KARTE 12\tREF 7 ", "", "12345", "Müller & Söhne"):
+        result = loaded.normalise(memo, GIROKONTO)
+        assert result.version == loaded.version
+        assert result.raw_memo == memo
+
+
+# --- tokens: case, whitespace, empty ---------------------------------------------
+
+
+def test_token_is_upper_cased_and_whitespace_collapsed(tmp_path: pathlib.Path) -> None:
+    result = normaliser.load(tmp_path).normalise("  beispiel \t markt \n", GIROKONTO)
+    assert _text(result) == "BEISPIEL MARKT"
+
+
+def test_an_all_noise_memo_gives_an_empty_token(tmp_path: pathlib.Path) -> None:
+    result = normaliser.load(tmp_path).normalise("REF 123 05.03. 99", GIROKONTO)
+    assert _text(result) == ""
+
+
+# --- user directory resolution ---------------------------------------------------
+
+
+def test_default_directory_follows_xdg_config_home(
+    tmp_path: pathlib.Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _write(
+        tmp_path / "xdg" / "autobook" / "normaliser",
+        "default.toml",
+        "[[rules]]\npattern = '\\bMARKT\\b'\n",
+    )
+    monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path / "xdg"))
+    result = normaliser.load().normalise("Beispiel Markt", GIROKONTO)
+    assert _text(result) == "BEISPIEL"
+
+
+def test_default_directory_falls_back_to_home_config(
+    tmp_path: pathlib.Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _write(
+        tmp_path / "home" / ".config" / "autobook" / "normaliser",
+        "default.toml",
+        "[[rules]]\npattern = '\\bMARKT\\b'\n",
+    )
+    monkeypatch.setenv("XDG_CONFIG_HOME", "")
+    monkeypatch.setenv("HOME", str(tmp_path / "home"))
+    assert _text(normaliser.load().normalise("Beispiel Markt", GIROKONTO)) == "BEISPIEL"
+
+
+# --- NormaliserError -------------------------------------------------------------
+
+
+def test_normaliser_error_is_a_value_error() -> None:
+    assert issubclass(normaliser.NormaliserError, ValueError)
+
+
+@pytest.mark.parametrize(
+    ("name", "text"),
+    [
+        ("bad.toml", "[[rules]\n"),
+        ("bad.toml", "[[rules]]\npattern = '('\n"),
+        ("bad.toml", "[[rules]]\npattern = 5\n"),
+        ("bad.toml", "[[rules]]\npattern = 'X'\nflags = 'i'\n"),
+        ("bad.toml", "[[rules]]\n"),
+        ("bad.toml", "rule = []\n"),
+        ("bad.toml", "rules = 'X'\n"),
+        ("accounts.toml", '[[accounts]]\npath = "Aktiva:Girokonto"\nprofile = "default"\n'),
+        ("accounts.toml", '[[accounts]]\npath = []\nprofile = "default"\n'),
+        ("accounts.toml", '[[accounts]]\npath = ["Aktiva", ""]\nprofile = "default"\n'),
+        ("accounts.toml", '[[accounts]]\npath = ["Aktiva"]\nprofile = "missing"\n'),
+        ("accounts.toml", '[[accounts]]\npath = ["Aktiva"]\n'),
+        ("accounts.toml", '[[accounts]]\npath = ["Aktiva"]\nprofile = 1\n'),
+        ("accounts.toml", 'extra = 1\n[[accounts]]\npath = ["Aktiva"]\nprofile = "default"\n'),
+        (
+            "accounts.toml",
+            '[[accounts]]\npath = ["Aktiva"]\nprofile = "default"\n'
+            '[[accounts]]\npath = ["Aktiva"]\nprofile = "sepa"\n',
+        ),
+    ],
+)
+def test_bad_input_raises_normaliser_error(
+    name: str, text: str, tmp_path: pathlib.Path
+) -> None:
+    _write(tmp_path, name, text)
+    with pytest.raises(normaliser.NormaliserError):
+        normaliser.load(tmp_path)
+
+
+def test_error_names_the_file(tmp_path: pathlib.Path) -> None:
+    _write(tmp_path, "typo.toml", "[[rules]]\npatern = 'X'\n")
+    with pytest.raises(normaliser.NormaliserError, match=r"typo\.toml"):
+        normaliser.load(tmp_path)
+
+
+def test_an_unreadable_user_directory_raises(tmp_path: pathlib.Path) -> None:
+    # It exists but cannot be listed: its profiles and mapping must not be dropped
+    # silently, as if the directory were absent.
+    user = _write(tmp_path / "user", "accounts.toml", SEPA_MAPPING)
+    user.chmod(0o300)
+    try:
+        # Root can list it anyway; the test is only meaningful for a normal user.
+        assert not os.access(user, os.R_OK), "the test must not run as root"
+        with pytest.raises(normaliser.NormaliserError, match="cannot read"):
+            normaliser.load(user)
+    finally:
+        user.chmod(0o700)
+
+
+def test_a_user_directory_that_is_a_file_raises(tmp_path: pathlib.Path) -> None:
+    (tmp_path / "file").write_text("", encoding="utf-8")
+    with pytest.raises(normaliser.NormaliserError):
+        normaliser.load(tmp_path / "file")
+    with pytest.raises(normaliser.NormaliserError):
+        normaliser.load(tmp_path / "file" / "normaliser")
+
+
+def test_a_broken_profile_link_raises_and_a_hidden_one_is_ignored(
+    tmp_path: pathlib.Path,
+) -> None:
+    # An editor's lock file (`.#name.toml`, a dangling link) is not a profile.
+    (tmp_path / ".#sepa.toml").symlink_to(tmp_path / "gone")
+    assert _text(normaliser.load(tmp_path).normalise("X", GIROKONTO)) == "X"
+    (tmp_path / "sepa.toml").symlink_to(tmp_path / "gone")
+    with pytest.raises(normaliser.NormaliserError, match=r"sepa\.toml"):
+        normaliser.load(tmp_path)
+
+
+def test_malformed_source_account_raises(tmp_path: pathlib.Path) -> None:
+    loaded = normaliser.load(tmp_path)
+    with pytest.raises(normaliser.NormaliserError):
+        loaded.normalise("X", ())
+    with pytest.raises(normaliser.NormaliserError):
+        loaded.normalise("X", ("Aktiva", ""))
