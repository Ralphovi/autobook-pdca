index 0000000..52a2be2
--- /dev/null
+++ b/src/autobook/pipeline/profiles/sepa.toml
@@ -0,0 +1,34 @@
+# Package profile `sepa`: the SEPA fields, then everything `default` does.
+# A profile file has no include, so the `default` rules are repeated below, in the same
+# order; tests/test_normaliser.py fails when the two files drift apart.
+
+# The tag and its value, up to the next SEPA tag or the end of the memo. A tag is
+# found without a word boundary in front: some exports join the fields with no space
+# (`EREF+NOTPROVIDEDSVWZ+…`), and a missed tag would let a value run on over the
+# merchant name.
+[[rules]]
+pattern = '(?:EREF|MREF|CRED|ABWA)\+[\s\S]*?(?=(?:EREF|MREF|CRED|SVWZ|ABWA)\+|\Z)'
+
+# The payment purpose: only the tag goes, the text stays and is cleaned by the rules below.
+[[rules]]
+pattern = 'SVWZ\+'
+
+# --- the `default` rules ---
+
+[[rules]]
+pattern = '\bSAGT DANKE\b'
+
+[[rules]]
+pattern = '\bKARTE \d+'
+
+[[rules]]
+pattern = '\bREF \d+'
+
+[[rules]]
+pattern = '\bNR\. *\d+'
+
+[[rules]]
+pattern = '\b\d{1,2}\.\d{1,2}\.(?:\d{4})?'
+
+[[rules]]
+pattern = '\b\d+\b'
