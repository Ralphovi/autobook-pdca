diff --git a/tests/fixtures/synthetic/corpus_builder.py b/tests/fixtures/synthetic/corpus_builder.py
new file mode 100644
index 0000000..e42a366
--- /dev/null
+++ b/tests/fixtures/synthetic/corpus_builder.py
@@ -0,0 +1,101 @@
+"""Seeded builder for a synthetic ``corpus`` contract object.
+
+Every merchant, memo and amount is invented (see README.md). Amounts are integer
+cents. The account tree is the one `tests/book/synthetic_book.py` builds, written
+here as component tuples because that module imports `gnucash` and cannot be
+loaded on the host.
+"""
+
+from __future__ import annotations
+
+import datetime
+import random
+from typing import NamedTuple
+
+from autobook.contracts import CorpusContract, CorpusRow, Sign
+
+GIROKONTO = ("Aktiva", "Girokonto")
+REVOLUT = ("Aktiva", "Revolut")
+LEBENSMITTEL = ("Ausgaben", "Lebensmittel")
+MIETE = ("Ausgaben", "Miete")
+GEHALT = ("Einnahmen", "Gehalt")
+
+
+class Merchant(NamedTuple):
+    token: str
+    source: tuple[str, ...]
+    destination: tuple[str, ...]
+    sign: Sign
+    cents: tuple[int, int]  # inclusive range
+    per_month: tuple[int, int]  # inclusive range
+
+
+MERCHANTS: tuple[Merchant, ...] = (
+    Merchant("BEISPIELMARKT", GIROKONTO, LEBENSMITTEL, "out", (1500, 9500), (2, 4)),
+    Merchant("MUSTERBAECKEREI", GIROKONTO, LEBENSMITTEL, "out", (300, 1800), (2, 4)),
+    Merchant("TESTHOF GEMUESE", REVOLUT, LEBENSMITTEL, "out", (800, 4200), (1, 2)),
+    Merchant("MUSTER HAUSVERWALTUNG", GIROKONTO, MIETE, "out", (75000, 75000), (1, 1)),
+    Merchant("BEISPIEL ARBEITGEBER GMBH", GIROKONTO, GEHALT, "in", (240000, 260000), (1, 1)),
+)
+
+# Occurs exactly once, on the latest date, so a rolling-origin backtest sees it
+# only in the final month.
+NOVEL_MERCHANT = "NEUHEIM KIOSK"
+
+FIRST_MONTH = datetime.date(2025, 1, 1)
+MONTHS = 12
+# Regular rows fall on days 1-27; the novel row takes day 28 of the last month, a
+# date no other row has.
+LAST_REGULAR_DAY = 27
+NOVEL_DAY = 28
+
+# The kind of noise the normaliser strips: reference and card fragments, sequence
+# numbers, dates. {n} is a number, {d} a day, {m} a month.
+NOISE = (
+    "SAGT DANKE {n}",
+    "KARTE {n} {d:02d}.{m:02d}.",
+    "REF {n}",
+    "NR. {n}",
+    "{d:02d}.{m:02d}. {n}",
+    "",
+)
+
+
+def _month(index: int) -> tuple[int, int]:
+    zero_based = FIRST_MONTH.month - 1 + index
+    return FIRST_MONTH.year + zero_based // 12, zero_based % 12 + 1
+
+
+def build_corpus(seed: int) -> CorpusContract:
+    """Return a synthetic corpus; the same ``seed`` always gives an equal one."""
+    rng = random.Random(seed)  # noqa: S311  # synthetic data, not a security context
+    rows: list[CorpusRow] = []
+    for index in range(MONTHS):
+        year, month = _month(index)
+        for merchant in MERCHANTS:
+            for _ in range(rng.randint(*merchant.per_month)):
+                day = rng.randint(1, LAST_REGULAR_DAY)
+                noise = rng.choice(NOISE).format(n=rng.randint(100, 99999), d=day, m=month)
+                rows.append(
+                    CorpusRow(
+                        raw_memo=f"{merchant.token} {noise}".strip(),
+                        amount_cents=rng.randint(*merchant.cents),
+                        sign=merchant.sign,
+                        source_account=merchant.source,
+                        destination_account=merchant.destination,
+                        post_date=datetime.date(year, month, day),
+                    )
+                )
+    year, month = _month(MONTHS - 1)
+    rows.append(
+        CorpusRow(
+            raw_memo=f"{NOVEL_MERCHANT} {rng.randint(100, 99999)}",
+            amount_cents=rng.randint(200, 2500),
+            sign="out",
+            source_account=GIROKONTO,
+            destination_account=LEBENSMITTEL,
+            post_date=datetime.date(year, month, NOVEL_DAY),
+        )
+    )
+    rows.sort(key=lambda row: (row.post_date, row.raw_memo, row.amount_cents))
+    return CorpusContract(rows=tuple(rows))
diff --git a/tests/test_contracts.py b/tests/test_contracts.py
new file mode 100644
index 0000000..1b36de4
--- /dev/null
+++ b/tests/test_contracts.py
@@ -0,0 +1,440 @@
+"""The `corpus` and `coa` contracts: round trip, version check, integer money.
+
+`autobook.contracts` is loaded inside each test (via `_contracts()`), never at
+module scope, so a tree without it fails these tests instead of failing to
+collect them.
+"""
+
+from __future__ import annotations
+
+import copy
+import datetime
+import importlib
+import json
+from typing import Any
+
+import pytest
+
+
+def _contracts() -> Any:
+    return importlib.import_module("autobook.contracts")
+
+
+def corpus_document() -> dict[str, Any]:
+    return {
+        "contract": "corpus",
+        "version": 1,
+        "rows": [
+            {
+                "raw_memo": "BEISPIELMARKT SAGT DANKE 4711",
+                "amount_cents": 4290,
+                "sign": "out",
+                "source_account": ["Aktiva", "Girokonto"],
+                "destination_account": ["Ausgaben", "Lebensmittel"],
+                "post_date": "2026-01-02",
+                "provenance": "observed",
+            },
+            {
+                "raw_memo": "BEISPIEL ARBEITGEBER GMBH GEHALT",
+                "amount_cents": 250000,
+                "sign": "in",
+                "source_account": ["Aktiva", "Girokonto"],
+                "destination_account": ["Einnahmen", "Gehalt"],
+                "post_date": "2026-01-28",
+                "provenance": "observed",
+            },
+        ],
+    }
+
+
+def coa_document() -> dict[str, Any]:
+    return {
+        "contract": "coa",
+        "version": 1,
+        "accounts": [
+            {
+                "path": ["Aktiva", "Girokonto"],
+                "type": "BANK",
+                "placeholder": False,
+                "commodity": {"namespace": "CURRENCY", "mnemonic": "EUR"},
+                "fraction": 100,
+            },
+            {
+                "path": ["Ausgaben"],
+                "type": "EXPENSE",
+                "placeholder": True,
+                "commodity": {"namespace": "CURRENCY", "mnemonic": "EUR"},
+                "fraction": 100,
+            },
+        ],
+    }
+
+
+def _parse(name: str, document: object) -> Any:
+    return getattr(_contracts(), f"parse_{name}")(document)
+
+
+def _serialise(name: str, contract: object) -> Any:
+    return getattr(_contracts(), f"serialise_{name}")(contract)
+
+
+DOCUMENTS = {"corpus": corpus_document, "coa": coa_document}
+BODY_KEY = {"corpus": "rows", "coa": "accounts"}
+
+
+def _with(name: str, mutate: Any) -> dict[str, Any]:
+    document = DOCUMENTS[name]()
+    mutate(document)
+    return document
+
+
+def _row(document: dict[str, Any], key: str, value: object) -> None:
+    document["rows"][0][key] = value
+
+
+def _account(document: dict[str, Any], key: str, value: object) -> None:
+    document["accounts"][0][key] = value
+
+
+# --- (a) round trip ----------------------------------------------------------------
+
+
+@pytest.mark.parametrize("name", ["corpus", "coa"])
+def test_canonical_document_serialises_back_to_itself(name: str) -> None:
+    document = DOCUMENTS[name]()
+    assert _serialise(name, _parse(name, copy.deepcopy(document))) == document
+
+
+def test_corpus_object_round_trips_through_dict_and_json_text() -> None:
+    contracts = _contracts()
+    contract = contracts.CorpusContract(
+        rows=(
+            contracts.CorpusRow(
